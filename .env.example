# Supabase project URL and publishable key from Project Settings → API.
# The publishable key is safe for the browser. Never put the secret key in NEXT_PUBLIC_ vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used for Form School vision.
DEEPSEEK_API_KEY=

# Server-only. Unlocks paid reports after Checkout. Never use a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Server-only Stripe keys. Checkout is hidden until the secret key exists.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
